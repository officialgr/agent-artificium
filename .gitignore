__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.zip
*.tar.gz
.env
.env.*
artificium-code/config.json
artificium-code/.secrets.json

# Starting text lives in artificium-code/prompts/mind-seed/.
# Setup/start creates instance-owned mind files; keep them out of Git.
mind/*
!mind/.gitkeep
!mind/tools/
mind/tools/*
!mind/tools/scheduler.py
!mind/interactions/
mind/interactions/*
!mind/interactions/.gitkeep
!mind/space/
mind/space/*
!mind/space/.gitkeep
logs/*
!logs/.gitkeep
